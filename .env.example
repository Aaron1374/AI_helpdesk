# Provider: openai, google/gemini, xai/grok, openai_compatible, or ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# OpenAI or another OpenAI-compatible provider
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=
OPENAI_ORG_ID=

# Google Gemini
GOOGLE_API_KEY=

# xAI Grok
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Embedding provider/model. Gemini uses models such as gemini-embedding-001.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Local application settings
SECRET_KEY=change-me
DEV_USER_EMAIL=employee@example.com
DEV_USER_PASSWORD=dev-password
DEV_USER_ROLE=employee